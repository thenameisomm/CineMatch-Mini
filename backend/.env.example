# CineMatch-Mini backend env — copy to .env and adjust if needed.
# No external services required: local MongoDB only.
# NEVER commit .env to version control.

# Local MongoDB (database name must stay cinematch_mini — separate from the
# original CineMatch product database).
MONGODB_URI=mongodb://localhost:27017/cinematch_mini
MONGODB_DB_NAME=cinematch_mini

# JWT secrets (min 32 chars each). These dev defaults are NOT production secrets.
JWT_ACCESS_SECRET=mini-dev-access-secret-please-change-me-32chars
JWT_REFRESH_SECRET=mini-dev-refresh-secret-please-change-me-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
BCRYPT_COST=10

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Server
PORT=3000
NODE_ENV=development

# Rate limiting (failed auth attempts only — successes are refunded, so real
# users never see "Too many attempts" from normal logins).
# Leave AUTH_RATE_LIMIT_MAX unset for env-aware default (30 dev / 5 prod).
# AUTH_RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
